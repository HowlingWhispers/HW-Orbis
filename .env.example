# Browser API base. Use /api in production. Leave empty to use presentation fixtures.
# VITE_HW_LIBRARY_API_URL remains supported as a compatibility fallback.
VITE_ORBIS_API_URL=
VITE_HW_LIBRARY_API_URL=
VITE_DISCORD_INVITE_URL=

# Orbis API service
NODE_ENV=development
PORT=8789
APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://orbis:change-me@127.0.0.1:5432/orbis
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=orbis.sid
TRUST_PROXY=false

# Discord OAuth application for Orbis
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5174/api/auth/discord/callback
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs, never role names.
# Adult roles can view restricted records. Creator roles can create and edit owned records.
DISCORD_ADULT_ROLE_IDS=
DISCORD_CREATOR_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=

# Always remains server-controlled and is unioned with editable admin roles for recovery.
DISCORD_BOOTSTRAP_ADMIN_ROLE_IDS=

# Compatibility fallback until saved through Orbis administration.
DISCORD_INVITE_URL=

# Optional read-only build information shown in Orbis administration.
ORBIS_VERSION=0.2.0
ORBIS_BUILD_SHA=

# Encrypts each user's saved NovelAI token. Generate exactly 32 random bytes:
# openssl rand -base64 32
ORBIS_CREDENTIAL_ENCRYPTION_KEY=

# Private Orbis to Speculus launch bridge. This secret must match Speculus.
SPECULUS_BRIDGE_URL=http://127.0.0.1:8790
SPECULUS_BRIDGE_SECRET=
SPECULUS_LAUNCH_TTL_SECONDS=14400
